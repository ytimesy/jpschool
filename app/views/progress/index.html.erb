<section class="progress-screen">
  <div class="screen-label"><%= t('progress.screen') %></div>
  <div class="page-title-row">
    <div>
      <p class="eyebrow"><%= t('progress.label') %></p>
      <h2><%= t('progress.title') %></h2>
    </div>
    <span class="status-pill"><%= t('progress.last_learning') %></span>
  </div>

  <div class="summary-grid">
    <article>
      <span><%= t('progress.completed') %></span>
      <strong><%= demo_user[:completed_count] %></strong>
    </article>
    <article>
      <span><%= t('progress.passed') %></span>
      <strong><%= demo_user[:passed_count] %></strong>
    </article>
    <article>
      <span><%= t('progress.review') %></span>
      <strong><%= demo_user[:review_count] %></strong>
    </article>
    <article>
      <span><%= t('common.highest_score') %></span>
      <strong>95</strong>
    </article>
  </div>

  <div class="table-card">
    <table>
      <thead>
        <tr>
          <th><%= t('progress.lesson') %></th>
          <th><%= t('progress.status') %></th>
          <th><%= t('common.highest_score') %></th>
        </tr>
      </thead>
      <tbody>
        <% demo_lessons.first(5).each do |lesson| %>
          <tr>
            <td><%= lesson[:title] %></td>
            <td><%= lesson[:status] %></td>
            <td><%= lesson[:highest_score] || '-' %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>
