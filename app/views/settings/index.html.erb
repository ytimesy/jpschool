<section class="settings-screen">
  <div class="screen-label"><%= t('settings.screen') %></div>
  <div class="page-title-row">
    <div>
      <p class="eyebrow"><%= demo_user[:display_name] %></p>
      <h2><%= t('settings.title') %></h2>
    </div>
  </div>

  <form class="form-stack" action="<%= settings_path %>" method="get">
    <label>
      <span><%= t('common.locale') %></span>
      <select name="locale">
        <option value="ja" <%= 'selected' if current_locale == :ja %>><%= t('common.japanese') %></option>
        <option value="en" <%= 'selected' if current_locale == :en %>><%= t('common.english') %></option>
        <option value="vi" <%= 'selected' if current_locale == :vi %>><%= t('common.vietnamese') %></option>
        <option value="zh" <%= 'selected' if current_locale == :zh %>><%= t('common.chinese') %></option>
      </select>
    </label>
    <label>
      <span><%= t('common.current_password') %></span>
      <input type="password">
    </label>
    <label>
      <span><%= t('common.new_password') %></span>
      <input type="password">
    </label>
    <button type="submit" class="primary-action"><%= t('common.save') %></button>
  </form>

  <%= link_to t('common.logout'), login_path, class: 'danger-action' %>
</section>
