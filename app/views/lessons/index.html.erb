<section class="lesson-list">
  <div class="screen-label"><%= t('lessons.screen_index') %></div>
  <div class="page-title-row">
    <div>
      <p class="eyebrow"><%= t('lessons.course') %></p>
      <h2><%= t('lessons.learn') %></h2>
    </div>
    <span class="status-pill"><%= t('common.lessons_count', count: 12) %></span>
  </div>

  <div class="lesson-grid">
    <% @lessons.each do |lesson| %>
      <article class="lesson-card">
        <div>
          <span class="lesson-number"><%= lesson[:id] %></span>
          <span class="status-pill"><%= lesson[:status] %></span>
        </div>
        <h3><%= lesson[:title] %></h3>
        <% unless current_locale == :ja %>
          <p class="kana-text"><%= lesson[:japanese_title] %></p>
        <% end %>
        <p><%= lesson[:description] %></p>
        <div class="meta-row">
          <span><%= t('common.minutes', count: lesson[:minutes]) %></span>
          <span><%= t('common.highest_score') %>: <%= lesson[:highest_score] || '-' %></span>
        </div>
        <%= link_to t('lessons.view'), lesson_path(lesson[:id]), class: 'secondary-action' %>
      </article>
    <% end %>
  </div>
</section>
