<section class="admin-lesson-detail">
  <div class="screen-label">教材詳細</div>
  <div class="page-title-row">
    <div>
      <p class="eyebrow">教材詳細</p>
      <h2><%= @lesson[:title] %></h2>
    </div>
    <%= link_to 'プレビュー', preview_admin_lesson_path(@lesson[:id]), class: 'primary-action compact' %>
  </div>

  <article class="status-panel">
    <h3>公開前チェック</h3>
    <p>翻訳: 完了</p>
    <p>音声: 警告あり</p>
    <p class="muted">音声欠落は学習画面ではテキスト継続可能として表示します。</p>
  </article>
</section>
