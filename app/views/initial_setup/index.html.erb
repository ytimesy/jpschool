<section class="auth-panel">
  <div class="screen-label"><%= t('initial_setup.screen') %></div>
  <h2><%= t('initial_setup.title') %></h2>
  <p class="muted"><%= t('initial_setup.description') %></p>

  <form class="form-stack" action="<%= root_path %>" method="get">
    <label>
      <span><%= t('common.locale') %></span>
      <select name="locale">
        <option value="ja" <%= 'selected' if current_locale == :ja %>><%= t('common.japanese') %></option>
        <option value="en" <%= 'selected' if current_locale == :en %>><%= t('common.english') %></option>
        <option value="vi" <%= 'selected' if current_locale == :vi %>><%= t('common.vietnamese') %></option>
        <option value="zh" <%= 'selected' if current_locale == :zh %>><%= t('common.chinese') %></option>
      </select>
    </label>
    <label>
      <span><%= t('common.new_password') %></span>
      <input type="password" value="new-password">
    </label>
    <label>
      <span><%= t('initial_setup.confirm_password') %></span>
      <input type="password" value="new-password">
    </label>
    <div class="policy-box">
      <h3><%= t('initial_setup.policy_title') %></h3>
      <p><%= t('initial_setup.policy_body') %></p>
    </div>
    <button type="submit" class="primary-action"><%= t('initial_setup.submit') %></button>
  </form>
</section>
