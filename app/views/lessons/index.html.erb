<section>
  <h2 class="text-2xl font-semibold mb-4">教材一覧</h2>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <% @lessons.each do |lesson| %>
      <article class="p-4 border rounded bg-white">
        <h3 class="text-lg font-medium"><%= lesson[:title] %></h3>
        <p class="text-sm text-gray-600"><%= lesson[:description] %></p>
        <div class="mt-3">
          <a href="#" class="text-indigo-600">詳細を見る</a>
        </div>
      </article>
    <% end %>
  </div>
</section>
