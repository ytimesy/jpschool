<section class="lesson-detail">
  <div class="screen-label"><%= t('lessons.screen_show') %></div>
  <div class="page-title-row">
    <div>
      <p class="eyebrow"><%= t('lessons.lesson') %> <%= @lesson[:id] %> / 12</p>
      <h2><%= @lesson[:title] %></h2>
      <% unless current_locale == :ja %>
        <p class="kana-text"><%= @lesson[:japanese_title] %></p>
      <% end %>
    </div>
    <span class="status-pill"><%= t('common.minutes', count: @lesson[:minutes]) %></span>
  </div>

  <div class="progress-track" aria-label="<%= t('nav.progress') %>">
    <span style="width: 50%"></span>
  </div>

  <article class="objective-card">
    <h3><%= t('lessons.objective') %></h3>
    <p><%= @lesson[:objective] %></p>
  </article>

  <div class="phrase-stack">
    <% @lesson[:phrases].each do |p| %>
      <article class="phrase-card">
        <div class="phrase-body">
          <div>
            <p class="japanese-text"><%= p[:japanese] %></p>
            <p class="kana-text"><%= p[:kana] %></p>
            <p class="translation-text"><%= p[:translation][current_locale] || p[:translation][:en] || p[:translation][:ja] %></p>
            <p class="muted"><%= p[:note] %></p>
          </div>
          <div class="audio-box">
            <% if p[:audio].present? %>
              <audio src="<%= p[:audio] %>" controls></audio>
            <% else %>
              <span><%= t('lessons.audio_missing') %></span>
            <% end %>
            <% if p[:audio].present? %>
              <div class="speed-control" aria-label="<%= t('lessons.audio_speed') %>">
                <button type="button">0.75x</button>
                <button type="button" class="active">1.0x</button>
              </div>
            <% end %>
          </div>
        </div>
      </article>
    <% end %>
  </div>

  <article class="dialogue-card">
    <h3><%= t('lessons.dialogue') %></h3>
    <% @lesson[:dialogue_lines].each do |line| %>
      <div class="dialogue-line">
        <strong><%= line[:speaker] %></strong>
        <p><%= line[:japanese] %></p>
        <p class="kana-text"><%= line[:kana] %></p>
        <p class="translation-text"><%= line[:translation] %></p>
      </div>
    <% end %>
  </article>

  <div class="sticky-actions">
    <%= link_to t('common.previous'), lessons_path, class: 'secondary-action' %>
    <%= link_to t('lessons.quiz'), lesson_quiz_path(@lesson[:id]), class: 'primary-action' %>
  </div>
</section>
