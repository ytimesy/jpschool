<section class="review-screen">
  <div class="screen-label"><%= t('review.screen') %></div>
  <div class="page-title-row">
    <div>
      <p class="eyebrow"><%= t('review.order') %></p>
      <h2><%= t('review.title') %></h2>
    </div>
    <span class="status-pill"><%= t('common.items_count', count: @items.length) %></span>
  </div>

  <div class="review-list">
    <% @items.each do |i| %>
      <article>
        <span class="status-pill"><%= t('review.unresolved') %></span>
        <h3><%= i[:question] %></h3>
        <p class="muted"><%= t('review.wrong_count', count: i[:wrong_count]) %></p>
        <form class="quiz-form" action="<%= review_path %>" method="get">
          <p class="muted"><%= t('review.answer_prompt') %></p>
          <div class="option-stack">
            <% i[:options].each_with_index do |opt, idx| %>
              <label class="option-row">
                <input type="radio" name="review_answers[<%= i[:id] %>]" value="<%= idx + 1 %>">
                <span><%= opt %></span>
              </label>
            <% end %>
          </div>
          <button type="submit" class="secondary-action"><%= t('review.submit') %></button>
        </form>
      </article>
    <% end %>
  </div>
</section>
