<section class="review-screen">
  <div class="screen-label"><%= t('review.screen') %></div>
  <div class="page-title-row">
    <div>
      <p class="eyebrow"><%= t('review.order') %></p>
      <h2><%= t('review.title') %></h2>
    </div>
    <span class="status-pill"><%= t('common.items_count', count: @items.length) %></span>
  </div>

  <div class="review-list">
    <% @items.each do |i| %>
      <article>
        <span class="status-pill"><%= t('review.unresolved') %></span>
        <h3><%= i[:question] %></h3>
        <p class="muted"><%= t('review.wrong_count', count: i[:wrong_count]) %></p>
        <p><%= t('review.answer', answer: 'Good morning.') %></p>
        <%= link_to t('review.resolve'), review_path, class: 'secondary-action' %>
      </article>
    <% end %>
  </div>
</section>
