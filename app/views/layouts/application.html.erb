<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <title>しごと日本語 / Work Nihongo</title>
    <%= stylesheet_link_tag 'application', media: 'all', 'data-turbo-track': 'reload' %>
    <%= javascript_include_tag 'application', 'data-turbo-track': 'reload', defer: true %>
  </head>
  <body class="bg-gray-50 text-gray-900">
    <header class="bg-white shadow">
      <div class="max-w-5xl mx-auto px-4 py-4 flex items-center justify-between">
        <h1 class="text-lg font-semibold"><a href="/">しごと日本語</a></h1>
        <nav>
          <a href="/" class="mr-4 text-sm text-gray-700">ホーム</a>
          <a href="/lessons" class="text-sm text-gray-700">教材一覧</a>
        </nav>
      </div>
    </header>

    <main class="max-w-5xl mx-auto px-4 py-8">
      <%= yield %>
    </main>

    <footer class="border-t">
      <div class="max-w-5xl mx-auto px-4 py-6 text-sm text-gray-600">© 2026 しごと日本語</div>
    </footer>

    <%= render 'shared/bottom_nav' %>

    <script src="/js/site.js"></script>
  </body>
</html>
