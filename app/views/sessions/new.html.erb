<section class="auth-panel">
  <div class="screen-label"><%= t('login.screen') %></div>
  <h2><%= t('login.title') %></h2>
  <p class="muted"><%= t('login.description') %></p>

  <form class="form-stack" action="<%= root_path %>" method="get">
    <label>
      <span><%= t('login.login_id') %></span>
      <input type="text" value="A0001" autocomplete="username">
    </label>
    <label>
      <span><%= t('login.password') %></span>
      <input type="password" value="password" autocomplete="current-password">
    </label>
    <label>
      <span><%= t('common.locale') %></span>
      <select name="locale">
        <option value="ja" <%= 'selected' if current_locale == :ja %>><%= t('common.japanese') %></option>
        <option value="en" <%= 'selected' if current_locale == :en %>><%= t('common.english') %></option>
        <option value="vi" <%= 'selected' if current_locale == :vi %>><%= t('common.vietnamese') %></option>
        <option value="zh" <%= 'selected' if current_locale == :zh %>><%= t('common.chinese') %></option>
      </select>
    </label>
    <button type="submit" class="primary-action"><%= t('login.submit') %></button>
  </form>

  <p class="notice-text"><%= t('login.forgot') %></p>
</section>
