<div class="prose">
  <h2>小テスト</h2>
  <form action="/lessons/<%= @lesson_id %>/quiz" method="post">
    <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
    <% @questions.each do |q| %>
      <div class="p-3 bg-white border rounded mb-3">
        <div class="font-medium">Q<%= q[:id] %>. <%= q[:question] %></div>
        <% q[:options].each_with_index do |opt, idx| %>
          <div>
            <label>
              <input type="radio" name="answers[<%= q[:id] %>]" value="<%= idx+1 %>"> <%= opt %>
            </label>
          </div>
        <% end %>
      </div>
    <% end %>
    <div>
      <button type="submit" class="px-4 py-2 bg-indigo-600 text-white rounded">回答を送信</button>
    </div>
  </form>
</div>
