<section class="lesson-detail">
  <div class="screen-label"><%= t('lessons.screen_show') %></div>
  <div class="page-title-row">
    <div>
      <p class="eyebrow"><%= t('lessons.lesson') %> <%= @lesson[:id] %> / 12</p>
      <h2><%= @lesson[:title] %></h2>
      <% unless current_locale == :ja %>
        <p class="kana-text"><%= @lesson[:japanese_title] %></p>
      <% end %>
    </div>
    <span class="status-pill"><%= t('common.minutes', count: @lesson[:minutes]) %></span>
  </div>

  <div class="progress-track" aria-label="<%= t('nav.progress') %>">
    <span style="width: 50%"></span>
  </div>

  <article class="objective-card">
    <p class="eyebrow"><%= t('lesson_detail.today_can_do') %></p>
    <h3><%= @lesson[:can_do][:statement] %></h3>
    <dl class="can-do-meta">
      <div>
        <dt><%= t('lesson_detail.level') %></dt>
        <dd><%= @lesson[:can_do][:level] %></dd>
      </div>
      <div>
        <dt><%= t('lesson_detail.activity') %></dt>
        <dd><%= @lesson[:can_do][:activity_label] %></dd>
      </div>
    </dl>
    <p class="muted"><%= @lesson[:can_do][:adapted] %></p>
  </article>

  <article class="dialogue-card">
    <h3><%= t('lesson_detail.pre_task') %></h3>
    <p><%= @lesson[:pre_task] %></p>
  </article>

  <div class="phrase-stack">
    <% @lesson[:phrases].each do |p| %>
      <article class="phrase-card">
        <div class="phrase-body">
          <div>
            <p class="japanese-text"><%= p[:japanese] %></p>
            <p class="kana-text"><%= p[:kana] %></p>
            <p class="translation-text"><%= p[:translation][current_locale] || p[:translation][:en] || p[:translation][:ja] %></p>
            <p class="muted"><%= p[:note] %></p>
          </div>
          <div class="audio-box">
            <% if p[:audio].present? %>
              <audio src="<%= p[:audio] %>" controls></audio>
            <% else %>
              <span><%= t('lessons.audio_missing') %></span>
            <% end %>
            <% if p[:audio].present? %>
              <div class="speed-control" aria-label="<%= t('lessons.audio_speed') %>">
                <button type="button" data-audio-speed="0.75">0.75x</button>
                <button type="button" data-audio-speed="1.0" class="active">1.0x</button>
              </div>
            <% end %>
          </div>
        </div>
      </article>
    <% end %>
  </div>

  <article class="dialogue-card">
    <h3><%= t('lessons.dialogue') %></h3>
    <% @lesson[:dialogue_lines].each do |line| %>
      <div class="dialogue-line">
        <strong><%= line[:speaker] %></strong>
        <p><%= line[:japanese] %></p>
        <p class="kana-text"><%= line[:kana] %></p>
        <p class="translation-text"><%= line[:translation] %></p>
      </div>
    <% end %>
  </article>

  <article class="dialogue-card">
    <h3><%= t('lesson_detail.practice') %></h3>
    <ul class="activity-list">
      <% @lesson[:practice].each do |practice| %>
        <li><%= practice %></li>
      <% end %>
    </ul>
  </article>

  <article class="dialogue-card">
    <h3><%= t('lesson_detail.role_play') %></h3>
    <p><%= @lesson[:role_play][:instruction] %></p>
    <ul class="activity-list">
      <% @lesson[:role_play][:checklist].each do |item| %>
        <li><%= item %></li>
      <% end %>
    </ul>
  </article>

  <article class="dialogue-card">
    <h3><%= t('lesson_detail.self_assessment') %></h3>
    <% current_assessment = self_assessment_for(@lesson[:id]) %>
    <% if current_assessment.present? %>
      <p class="saved-assessment">
        <%= t('lesson_detail.self_assessment_current') %>: <strong><%= current_assessment["label"] %></strong>
      </p>
    <% end %>
    <%= form_with url: lesson_self_assessment_path(@lesson[:id]), method: :patch, class: "self-assessment-form" do %>
      <fieldset class="self-assessment-options">
        <legend><%= t('lesson_detail.self_assessment_prompt') %></legend>
        <% @lesson[:self_assessment_options].each do |option| %>
          <label>
            <%= radio_button_tag :rating, option[:rating], current_assessment&.fetch("rating", nil) == option[:rating] %>
            <span><%= option[:label] %></span>
          </label>
        <% end %>
      </fieldset>
      <%= submit_tag t('lesson_detail.self_assessment_submit'), class: 'secondary-action' %>
    <% end %>
    <p class="muted"><%= @lesson[:reflection] %></p>
  </article>

  <div class="sticky-actions">
    <%= link_to t('common.previous'), lessons_path, class: 'secondary-action' %>
    <%= link_to t('lessons.quiz'), lesson_quiz_path(@lesson[:id]), class: 'primary-action' %>
  </div>
</section>
