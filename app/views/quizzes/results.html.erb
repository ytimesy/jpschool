<section class="result-screen">
  <div class="screen-label"><%= t('quiz.result_screen') %></div>
  <article class="score-card">
    <p class="eyebrow"><%= t('quiz.result_title') %></p>
    <h2><%= t('quiz.score', score: @score) %></h2>
    <p><%= t('quiz.correct_count', correct: @correct, total: @total) %></p>
    <span class="status-pill"><%= @score >= 80 ? t('quiz.passed') : t('quiz.retry_needed') %></span>
  </article>

  <div class="result-list">
    <article>
      <strong><%= t('quiz.correct') %></strong>
      <p><%= t('quiz.correct_body') %></p>
    </article>
    <article>
      <strong><%= t('quiz.explanation') %></strong>
      <p><%= t('quiz.explanation_body') %></p>
    </article>
  </div>

  <div class="sticky-actions">
    <%= link_to t('quiz.retry'), lesson_quiz_path(params[:lesson_id]), class: 'secondary-action' %>
    <% if @next_lesson %>
      <%= link_to t('quiz.next_lesson'), lesson_path(@next_lesson[:id]), class: 'primary-action' %>
    <% else %>
      <%= link_to t('nav.lessons'), lessons_path, class: 'primary-action' %>
    <% end %>
  </div>
</section>
